{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/como-funciona",
      "destination": "/como-trabajamos",
      "permanent": true
    },
    {
      "source": "/como-funciona.html",
      "destination": "/como-trabajamos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/presupuesto",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
